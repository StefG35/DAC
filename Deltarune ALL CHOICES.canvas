		{"id":"96490a1f5c536f0f","type":"text","text":"Sa che hai reclutato quelli del capitolo 3","x":-1834,"y":29968,"width":250,"height":60},
		{"id":"74ce7f1b427df023","type":"text","text":"Recluti i puntoli nel capitolo 3","x":-1782,"y":30112,"width":146,"height":90,"color":"#ffffc8"},
