		{"id":"1b4d57e4a440c442","type":"text","text":"Non recluti nessuno nel capitolo 2","x":3786,"y":29016,"width":146,"height":90,"color":"#ff9696"},
		{"id":"cda0a8bb1019f122","type":"text","text":"La stanza è ben arredata con tanto di mini-città","x":3186,"y":29234,"width":200,"height":80},
