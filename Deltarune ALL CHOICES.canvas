		{"id":"d80bd8ed7dab5fae","type":"text","text":"Noelle equipaggia di nuovo l'AnelloSpine. La Weird Route continua","x":-502,"y":30157,"width":242,"height":89,"color":"#5c0000"},
		{"id":"4aa0a4378ec5cb25","type":"text","text":"Sa che hai attaccato quelli del capitolo 3","x":-2281,"y":29968,"width":250,"height":60},
