		{"id":"d05795f5b4ec547f","type":"text","text":"Il quadriano Blu ti dice qual è il clima di Città Castello","x":-991,"y":29098,"width":240,"height":87,"color":"4"},
		{"id":"ff2fa842ffb4313d","type":"text","text":"Entrate a casa di Noelle senza farle perdere tempo","x":237,"y":29068,"width":250,"height":60},
