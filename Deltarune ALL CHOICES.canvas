		{"id":"cec1294a518cd189","type":"text","text":"Recluti tutti nel capitolo 3","x":2906,"y":29016,"width":146,"height":90,"color":"#c8ffc8"},
		{"id":"8ea627b0bf11d115","type":"text","text":"Recluti qualcuno nel capitolo 3","x":3040,"y":29560,"width":146,"height":90,"color":"#ffffc8"},
